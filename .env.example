# ============================================================================
# Snap Coin Pool Configuration
# Copy to .env and fill in your values
# ============================================================================

# Node address:port to connect to for blockchain sync
POOL_NODE=127.0.0.1:3003

# Pool private key (base36) — signs payout transactions
POOL_PRIVATE=your_base36_private_key_here

# Pool operator wallet (base36 public key) — receives pool fee
POOL_DEV=your_base36_public_key_here

# Share difficulty target (64-char hex, lower = harder)
POOL_DIFFICULTY=0000ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff

# Pool operator fee (0.0 - 0.10, default: 0.02 = 2%)
POOL_FEE=0.02

# Pool listening port (default: 5334)
POOL_PORT=5334

# Data directory for persistence (default: ./pool-data)
POOL_DATA_DIR=./pool-data

# Max connections per IP (default: 5)
POOL_MAX_CONN=5

# Log level (optional, default: info)
# Options: trace, debug, info, warn, error
RUST_LOG=info